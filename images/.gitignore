# Packer auto-loaded variables (like terraform.tfvars)
*.auto.pkrvars.hcl

# Packer variables with credentials
*.pkrvars.hcl
!*.pkrvars.hcl.example

# Environment files with credentials
.env
.env.local

# Packer cache
packer_cache/

# Packer build outputs
output-*/
*.box

# Packer crash logs
crash.log

# Manifests (may contain sensitive info)
manifests/
