# Proxmox Configuration
proxmox_api_url          = "https://192.168.1.10:8006/api2/json"
proxmox_api_token_id     = "terraform@pam!terraform"
proxmox_api_token_secret = "your-api-token-secret-here"
proxmox_node             = "pve"

# VM Template Configuration
template_name = "ubuntu-cloud-template"
storage_pool  = "local-lvm"

# SSH Configuration
ssh_public_key       = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC... your-public-key"
ssh_private_key_path = "~/.ssh/id_rsa"
ssh_user             = "ubuntu"

# Network Configuration
gateway    = "192.168.1.1"
nameserver = "8.8.8.8"

# K3s Cluster Configuration
server_ip   = "192.168.1.100"
agent_count = 3
agent_ips   = ["192.168.1.101", "192.168.1.102", "192.168.1.103"]
